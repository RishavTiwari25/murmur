# ---------------------------------------------------------------------------
# Minimal deployment (Vercel + Neon Postgres + Upstash Redis) needs ONLY:
#   DATABASE_URL, REDIS_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL, APP_URL,
#   MURMUR_EXECUTION_MODE=direct
# Models go through the Vercel AI Gateway. On Vercel it authenticates with the
# deployment's OIDC token automatically, so no model API key is required.
# Kafka, Stripe, Temporal, Cloudinary, Firecrawl and the telemetry WebSocket
# are optional: leave their variables unset and the feature switches off.
# ---------------------------------------------------------------------------

# Local development: set AI_GATEWAY_API_KEY, or run `vercel env pull .env.local`
# to receive a short-lived VERCEL_OIDC_TOKEN. Off-Vercel workers need the key.
AI_GATEWAY_API_KEY=
# Optional fallback provider, used only when set (after the AI Gateway models).
OPENROUTER_API_KEY=
# Optional per-role model overrides (AI Gateway ids, e.g. google/gemini-2.5-flash).
MURMUR_PLANNER_MODEL=
MURMUR_VALIDATOR_MODEL=
MURMUR_WORKER_MODEL=
MURMUR_SYNTH_MODEL=
MURMUR_VISION_MODEL=

# Optional live web search for Researcher agents. Without this, Researcher agents
# state that live browsing is unavailable instead of fabricating current sources.
FIRECRAWL_API_KEY=

# Better Auth + PostgreSQL. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://murmur:murmur@localhost:5432/murmur
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AUTH_DB_POOL_SIZE=10

APP_URL=http://localhost:3000

# Optional: Stripe Pro subscriptions. Leave STRIPE_SECRET_KEY and
# STRIPE_PRO_PRICE_ID empty to disable billing: the upgrade button is hidden,
# /api/billing/* answers 503 "billing disabled", and every account stays on the
# free plan (free-tier rate limits still apply). To enable, create one recurring
# Price and a webhook for checkout.session.completed and customer.subscription.*.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=

# `direct` runs the swarm in the HTTP process (minimal deployments). Use
# `temporal` to move long runs onto a Temporal Worker (needs TEMPORAL_*).
MURMUR_EXECUTION_MODE=direct
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=murmur-swarm

# Optional Kafka mirror of run events (feeds the Go telemetry service). When
# KAFKA_BROKERS is unset Murmur never connects to Kafka, Redis stays the source
# of truth, and /api/health reports kafka as "disabled". For the local Compose
# stack (`pnpm infra:up`) uncomment the broker below. Production Kafka should use
# managed brokers with TLS/SASL and replication >= 3.
# KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=murmur-web
KAFKA_SWARM_EVENTS_TOPIC=murmur.swarm.events
# Local Compose has no TLS. Hosted production Kafka must set this to 1 and add
# its SASL username/password below.
KAFKA_SSL=0
# Optional for hosted brokers that use a private/project CA. Vercel accepts the
# full multiline PEM value as an encrypted environment variable.
KAFKA_CA_CERT=
KAFKA_SASL_MECHANISM=plain
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CONNECTION_TIMEOUT_MS=5000
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_RETRY_COUNT=8
KAFKA_LOG_LEVEL=error

# Go telemetry service (services/telemetry). HTTP serves /healthz, /metrics and
# the /ws event socket; gRPC serves TelemetryService, health and reflection.
TELEMETRY_PORT=9091
TELEMETRY_GRPC_PORT=9090
# Comma-separated exact origins allowed to open ws://.../ws. A WebSocket
# handshake is a plain GET, so CORS preflight never protects it. Production must
# list the deployed web origin, e.g. https://murmur.vercel.app.
TELEMETRY_WS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. Which transport the browser uses for the live run stream. Set =
# WebSocket first, with automatic fallback to the SSE response; empty = SSE only
# (the default for minimal deployments, which have no telemetry service).
# Local Compose publishes the socket on 9091; production must be wss:// and
# must be a public address, because this URL is dialled by the user's browser,
# not by the server. NEXT_PUBLIC_ values are inlined at build time, so changing
# it in production requires a redeploy.
# NEXT_PUBLIC_TELEMETRY_WS_URL=ws://localhost:9091/ws
NEXT_PUBLIC_TELEMETRY_WS_URL=

# Required Redis state. Use rediss:// for TLS-enabled managed Redis in production.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
MURMUR_FREE_RUNS_PER_WINDOW=3
MURMUR_PRO_RUNS_PER_WINDOW=100
MURMUR_FREE_MAX_RUNS_PER_WINDOW=1
MURMUR_PRO_MAX_RUNS_PER_WINDOW=100
MURMUR_RUN_WINDOW_SECONDS=3600
MURMUR_MODEL_CALLS_PER_WINDOW=120
MURMUR_MODEL_WINDOW_SECONDS=3600
MURMUR_RUN_SESSION_TTL_SECONDS=86400
MURMUR_RUN_EVENT_STREAM_MAX_LENGTH=10000
MURMUR_INFRA_HEALTH_CACHE_MS=5000

# --- Azure Event Hubs (Kafka protocol) ---
# Optional managed alternative to a self-hosted Kafka broker. When set, it overrides KAFKA_BROKERS.
# Get it from: Azure Portal > Event Hubs Namespace > Shared access policies > connection string.
# AZURE_EVENTHUBS_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>;EntityPath=<eventhub>
